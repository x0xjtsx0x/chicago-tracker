# Copy to deploy/chicago-tracker.env (git-ignored) or load from the homelab secret store.
# Never commit real values: this repository is public.

# Identity. The reverse proxy cannot set Tailscale-User-* headers, so the app runs in single-user
# mode: every request is this login and all Tailscale-User-* headers are ignored.
OWNER_LOGIN=you@example.com
SINGLE_USER_LOGIN=you@example.com
ALLOWED_LOGINS=

# The tailnet-only URL the proxy serves; used for the webcal link and push Click URLs.
PUBLIC_BASE_URL=https://chicago.<tailnet>.ts.net

# Contacts for the Nominatim and NWS User-Agents (their usage policies require one).
# City of Chicago requests use CITY_USER_AGENT, which must not contain an email address
# (the city CDN rejects those with HTTP 403). The default is fine.
NOMINATIM_CONTACT=you@example.com
NWS_USER_AGENT=chicago-tracker (you@example.com)
CITY_USER_AGENT=

SOCRATA_APP_TOKEN=

# Push: public ntfy.sh by default. The per-user topic is the credential (random, ≥ 128 bits).
# NTFY_TOKEN is optional; leave it empty for ntfy.sh. An empty NTFY_URL turns push off.
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=

REFRESH_CRON=30 3 * * *
